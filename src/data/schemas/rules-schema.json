{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "SrcsetRule": {
      "type": "object",
      "properties": {
        "hash": {
          "default": false,
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "enum": [
            "jpeg",
            "gif",
            "webp",
            "png"
          ]
        },
        "formatOptions": {
          "type": "object",
          "properties": {
            "quality": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "lossless": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "widths": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 9007199254740991
          }
        },
        "behavior": {
          "type": "string",
          "enum": [
            "skip",
            "throw",
            "full"
          ]
        }
      },
      "required": [
        "hash",
        "widths",
        "behavior"
      ],
      "additionalProperties": false
    },
    "RenameRule": {
      "type": "object",
      "properties": {
        "include": {
          "default": ".*",
          "type": "string"
        },
        "sort": {
          "type": "string",
          "enum": [
            "name",
            "date",
            "screenshot",
            "none"
          ]
        },
        "names": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "include",
        "sort",
        "names"
      ],
      "additionalProperties": false
    },
    "FormatRule": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "jpeg",
            "gif",
            "webp",
            "png"
          ]
        },
        "formatOptions": {
          "type": "object",
          "properties": {
            "quality": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "lossless": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "format"
      ],
      "additionalProperties": false
    },
    "CropRule": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string",
          "enum": [
            "percentage",
            "flat"
          ]
        },
        "extract": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number"
            },
            "left": {
              "type": "number"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          },
          "required": [
            "top",
            "left",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "use",
        "extract"
      ],
      "additionalProperties": false
    },
    "CopyRule": {
      "type": "object",
      "properties": {
        "hash": {
          "default": false,
          "type": "boolean"
        },
        "format": {
          "type": "string",
          "enum": [
            "jpeg",
            "gif",
            "webp",
            "png"
          ]
        },
        "formatOptions": {
          "type": "object",
          "properties": {
            "quality": {
              "type": "number",
              "minimum": 1,
              "maximum": 100
            },
            "lossless": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "hash"
      ],
      "additionalProperties": false
    },
    "$schema": {
      "type": "string",
      "pattern": "^(?:[a-zA-Z0-9_.-\\/]).+schema\\.json$"
    }
  },
  "required": [
    "$schema"
  ],
  "additionalProperties": false
}